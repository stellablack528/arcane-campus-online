          ],
          "response_lines": [
            {
              "type": "narration",
              "text": {
                "zh": "书页总在一个被撕掉的名字处停下。它在等人补完一句话，而不是索取魔法。",
                "en": "The pages always stop at a torn-out name. It wants a sentence restored, not a spell."
              }
            }
          ]
        },
