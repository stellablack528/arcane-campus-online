{
  "title": "Arcane Campus Online - Wand Customization Data",
  "version": "1.0",
  "canon_scope": {
    "source_policy": "Official Wizarding World / HarryPotter.com material only for canon fields",
    "note": "Wood, core and general length/flexibility information are canon-based. Handle appearance, finish, engraving, decorative materials and player-entered naming are game-original customization fields."
  },
  "player_fields": {
    "wand_name": {
      "type": "string",
      "required": false,
      "max_length": 32,
      "description": "Player-defined wand name"
    },
    "wood": {
      "type": "enum",
      "required": true,
      "description": "Wand wood; official Ollivander wand woods"
    },
    "core": {
      "type": "enum",
      "required": true,
      "description": "Core; Hogwarts/Ollivander default set"
    },
    "length_inches": {
      "type": "number",
      "required": true,
      "min": 9.0,
      "max": 14.0,
      "step": 0.25,
      "unit": "inch",
      "description": "Recommended player-choice range based on the official statement that most wands are 9–14 inches. The 0.25-inch step is a game UI choice, not a canon requirement."
    },
    "flexibility": {
      "type": "enum",
      "required": true,
      "description": "Flexibility descriptor. The official material treats flexibility as a wand characteristic but does not present one short exhaustive public enum; the presets below are observed on official wand pages."
    },
    "handle_style": {
      "type": "enum",
      "required": true,
      "canon_status": "game_original",
      "description": "Visual handle/grip style"
    },
    "finish": {
      "type": "enum",
      "required": false,
      "canon_status": "game_original",
      "description": "Surface finish / color treatment"
    },
    "engraving": {
      "type": "string",
      "required": false,
      "max_length": 24,
      "canon_status": "game_original",
      "description": "Optional engraving or maker mark"
    },
    "description": {
      "type": "string",
      "required": false,
      "max_length": 160,
      "canon_status": "game_original",
      "description": "Player's short description of the wand"
    }
  },
