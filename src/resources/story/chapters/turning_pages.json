          "response_lines": [
            {
              "type": "npc_dialogue",
              "actor_id": "librarian_mira",
              "speaker": {
                "zh": "图书管理员米拉",
                "en": "Librarian Mira"
              },
              "text": {
                "zh": "“好问题。纸太旧，先让我垫一张保护纸。”她展开书页：‘献给曾为陌生人留灯的艾琳。’",
                "en": "“Good question. The paper is old; let me support it.” She unfolds the page: ‘For Erin, who left a light for strangers.’"
              }
            }
          ]
        },
