    {
      "id": "library",
      "title": {
        "zh": "图书馆 · 旧书",
        "en": "Library · The Old Book"
      },
      "narration": {
        "zh": "一本薄薄的旧书在书架下自行翻页。它没有发光，也没有奖励；页边写着许多被划掉的名字。",
        "en": "A thin old book turns its pages beneath a shelf. It offers no glow or prize; many names are crossed out in its margins."
      },
      "revisit_narration": {
        "zh": "那本书还在这里，停在你刚才读过的一页。",
        "en": "The book remains here, open to the page you last read."
      },
      "actors": [
        "librarian_mira"
      ],
      "arrival_lines": [
        {
          "type": "npc_dialogue",
          "actor_id": "librarian_mira",
          "speaker": {
            "zh": "图书管理员米拉",
            "en": "Librarian Mira"
          },
          "text": {
            "zh": "“它不是在捣乱。先看清楚，再决定要不要告诉所有人。”",
            "en": "“It isn't misbehaving. Look closely before deciding who should know.”"
          }
        },
        {
          "type": "narration",
          "text": {
            "zh": "你想起庭院喷泉上的刻字，书页的缺口似乎正好对应那个名字。",
            "en": "You recall the inscription on the courtyard fountain. The torn page seems to match that name."
          },
          "conditions": [
            {
              "type": "has_flag",
              "key": "fountain_seen"
            }
          ]
        }
      ],
      "actions": [
        {
          "id": "inspect_turning_book",
          "label": {
            "zh": "观察翻页规律",
            "en": "Observe how the book turns"
          },
          "aliases": [
            "观察旧书",
            "调查书",
            "inspect book"
          ],
          "conditions": [
            {
              "type": "missing_flag",
              "key": "book_found"
