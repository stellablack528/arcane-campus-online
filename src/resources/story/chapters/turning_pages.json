          "response_lines": [
            {
              "type": "narration",
              "text": {
                "zh": "你让书页悬在空中，不碰它脆弱的边缘。背面写着：‘献给曾为陌生人留灯的艾琳。’这是记忆，不是藏宝图。",
                "en": "You hold the page aloft without touching its fragile edge. On the back: ‘For Erin, who left a light for strangers.’ It is a memory, not a treasure map."
              }
            }
          ]
        },
        {
          "id": "ask_mira_to_open_page",
          "label": {
            "zh": "请米拉帮忙保护书页",
            "en": "Ask Mira to protect the page"
          },
          "aliases": [
            "请管理员帮忙",
            "问米拉",
            "ask Mira"
          ],
          "conditions": [
            {
              "type": "has_flag",
              "key": "book_found"
            },
            {
              "type": "missing_flag",
              "key": "page_read"
