      "title": {
        "zh": "庭院 · 喷泉",
        "en": "Courtyard · The Fountain"
      },
      "narration": {
        "zh": "喷泉边的石灯白天也亮着。有人把刻字擦得很干净，却没有留下解释。",
        "en": "The stone lamp beside the fountain stays lit even by day. Someone has cleaned the inscription but left no explanation."
      },
      "revisit_narration": {
        "zh": "石灯仍亮着，水声盖过远处的谈话。",
        "en": "The stone lamp is still lit; water drowns out distant conversation."
      },
      "actors": [
        "prof_flitwick"
